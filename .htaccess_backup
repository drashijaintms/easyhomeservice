############################################################
# BASIC HARDENING
############################################################
Options -Indexes
RewriteEngine On
############################################################
# ABSOLUTE POLICY REDIRECT (EXECUTES FIRST)
############################################################
Redirect 301 /policy https://easyhomeservice.com/privacy-policy
Redirect 301 /policy-policy https://easyhomeservice.com/privacy-policy

############################################################
# ALLOW FAVICON & ICON FILES (NO REDIRECT / NO ROUTING)
############################################################
RewriteRule ^images/favicon\.png$ - [L]
RewriteRule ^favicon\.ico$ - [L]
RewriteRule ^favicon-.*\.png$ - [L]
RewriteRule ^apple-touch-icon.*\.png$ - [L]

############################################################
# ABSOLUTE BYPASS FOR INTERNAL APIs
############################################################
RewriteRule ^verify-api\.php$ - [L]
RewriteRule ^check-email\.php$ - [L]

############################################################
# FORCE NON-TRAILING SLASH (CANONICAL)
############################################################
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+)/$ https://easyhomeservice.com/$1 [R=301,L]

ServerSignature Off

############################################################
# HOST HEADER VALIDATION (CLOUD METADATA FIX – HIGH)
############################################################
RewriteCond %{HTTP_HOST} ^169\.254\.169\.254$ [OR]
RewriteCond %{HTTP_HOST} ^metadata\.google\.internal$ [OR]
RewriteCond %{HTTP_HOST} ^metadata$ [OR]
RewriteCond %{HTTP_HOST} ^instance-data$
RewriteRule .* - [F,L]

RewriteCond %{HTTP_HOST} !^(easyhomeservice\.com|www\.easyhomeservice\.com)$ [NC]
RewriteRule .* - [F,L]

############################################################
# FORCE HTTPS (CANONICAL)
############################################################
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

############################################################
# FORCE NON-WWW
############################################################
RewriteCond %{HTTP_HOST} ^www\.easyhomeservice\.com$ [NC]
RewriteRule ^(.*)$ https://easyhomeservice.com/$1 [R=301,L]

############################################################
# BLOCK EMPTY & MALICIOUS USER AGENTS
############################################################
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule .* - [F,L]

RewriteCond %{HTTP_USER_AGENT} (acunetix|sqlmap|nikto|nessus|nmap|masscan|wpscan|owasp|zap|zaproxy|dirbuster|whatweb|arachni|burp|burpsuite|havij|netsparker) [NC]
RewriteRule .* - [F,L]

############################################################
# BLOCK COMMON SCANNER PATHS
############################################################
RewriteCond %{REQUEST_URI} (\.\./|\%2e\%2e|/wp-admin|/wp-login|/xmlrpc\.php|/vendor/phpunit|/\.git|/\.env) [NC]
RewriteRule .* - [F,L]

############################################################
# SECURITY HEADERS (ALL PAGES)
############################################################
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
Header always set Cross-Origin-Opener-Policy "same-origin"

Header always set Content-Security-Policy "
default-src 'self';

script-src 'self' 'unsafe-inline'
https://cdn.tiny.cloud
https://cdn-app.continual.ly
https://api.mapbox.com
