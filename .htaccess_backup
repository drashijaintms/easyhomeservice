</IfModule>

############################################################
# SECURITY HEADERS FOR STATIC FILES
############################################################
<FilesMatch "\.(txt|xml)$">
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
Header always set Content-Security-Policy "default-src 'self'"
</FilesMatch>

############################################################
# EXTENSIONLESS PHP ROUTING (ROOT + SUBFOLDERS)
############################################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

############################################################
# LOAD folder/index.php SAFELY
############################################################
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.+?)/?$ $1/index.php [L]

############################################################
# BYPASS UNSUB ROUTE
############################################################
RewriteCond %{REQUEST_URI} ^/unsub/
RewriteRule ^ - [L]

############################################################
# API PREFLIGHT
############################################################
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(api|vonage)/ - [R=200,L]

############################################################
# VONAGE ROUTES
############################################################
RewriteRule ^vonage/verify-start$ vonage/verify-start.php [L]
RewriteRule ^vonage/verify-check$ vonage/verify-check.php [L]
RewriteRule ^vonage/verify-cancel$ vonage/verify-cancel.php [L]

############################################################
# REMOVE .PHP FROM URL (CANONICAL)
############################################################
RewriteCond %{THE_REQUEST} \s/([^\s\?]+)\.php[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

############################################################
# NORMALIZE MULTIPLE DASHES
############################################################
RewriteRule ^(.*)--+(.*)$ $1-$2 [N]

############################################################
# SIMPLE REDIRECTS
############################################################
RewriteRule ^privacy$ /privacy-policy [R=301,L]
RewriteRule ^pestcontrol$ /pest-control [R=301,L]


RewriteCond %{REQUEST_URI} !^/blog/$
RewriteRule ^blog/(.*)$ /$1 [R=301,L]

