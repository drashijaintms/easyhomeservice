RewriteEngine On
 
# General redirect based on 'permalink' query value, applied globally
 
# 1. historical windows
RewriteCond %{QUERY_STRING} (^|&)permalink=historical-windows---a-look-at-architectural-styles-across-america(&|$)
RewriteRule ^.*$ /blog/historical-windows-a-look-at-architectural-styles-across-america? [R=301,L]
 
# 2. home improvement trends
RewriteCond %{REQUEST_URI} ^/blog/2025-home-improvement-trends:-upgrades-for-a-stylish-home$
RewriteRule ^.*$ /blog/2025-Home-Improvement-Trends-Upgrades-for-a-Stylish-Home? [R=301,L]
 
# 3. sustainable kitchen
RewriteCond %{QUERY_STRING} (^|&)permalink=the-art-of-sustainable-kitchen-design:-balancing-style-and-environmental-impact(&|$)
RewriteRule ^.*$ /blog/the-art-of-sustainable-kitchen-design-balancing-style-and-environmental-impact? [R=301,L]
 
# 4. electric bill
RewriteCond %{REQUEST_URI} ^/blog/electric-bill-$
RewriteRule ^.*$ /blog/high-energy-bills-hidden-hvac-problems [R=301,L] 
 
# Ensure the query string is preserved
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ /blog/single.php?permalink=$1 [QSA,L]
 
# 1. Redirect from /allservices%7Bsearch_term_string%7D to /allservices
RewriteCond %{REQUEST_URI} ^/allservices%7Bsearch_term_string%7D$
RewriteRule ^ /allservices [L,R=301]
 
# 2. Exclude /blog/ (the exact URL) from redirection
RewriteCond %{REQUEST_URI} !^/blog/$
# Redirect all other /blog/* URLs to the root without /blog/
RewriteRule ^blog/(.*)$ /$1 [L,R=301]
 
# Redirect second URL
RewriteCond %{REQUEST_URI} ^/blog/single\.php$
RewriteCond %{QUERY_STRING} ^category=Blog\+Post&permalink=the-ultimate-guide-to-know-when-you-call-a-roofing-expert$
RewriteRule ^.*$ https://easyhomeservice.com/blog/the-ultimate-guide-to-know-when-you-call-a-roofing-expert? [R=301,L]
 
# Redirect third URL
RewriteCond %{REQUEST_URI} ^/blog/single\.php$
RewriteCond %{QUERY_STRING} ^category=Blog\+Post&permalink=the-art-of-sustainable-kitchen-design:-balancing-style-and-environmental-impact$
RewriteRule ^.*$ https://easyhomeservice.com/blog/the-art-of-sustainable-kitchen-design-balancing-style-and-environmental-impact? [R=301,L]
 
# Redirect fourth URL
RewriteCond %{REQUEST_URI} ^/blog/single\.php$
RewriteCond %{QUERY_STRING} ^category=Windows&permalink=historical-windows-a-look-at-architectural-styles-across-america$
RewriteRule ^.*$ https://easyhomeservice.com/blog/historical-windows-a-look-at-architectural-styles-across-america? [R=301,L]
 
RewriteRule ^electric-bill-?$ - [G,L]

# Redirects (301 & 410)
Redirect 301 /blog/admin/bathroom-remodeling-trends-2025 /bathroom
Redirect 301 /blog/admin/best-window-replacement-in-maryland /blog/best-window-replacement-in-maryland
Redirect 301 /blog/blog/the-ultimate-guide-to-know-when-you-call-a-roofing-expert /blog/roofing-projects-skylight-upgrade

